# ─────────────────────────────────────────────────────────────────────────────
# .env — ACCESS TOKENS & API KEYS ONLY
# All config flags, trading params, scanner settings → config.py
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM API Keys ─────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_API_KEY_2=
LLM_API_KEY_3=
# ─── Broker Keys ──────────────────────────────────────────────────────────────
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
INDMONEY_ACCESS_TOKEN=
# Groww — pick ONE flow (dashboard → account settings → Trading APIs → Generate API keys)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
ZEP_API_KEY=
NO_OPEN=1

# ─── Deribit (Crypto Derivatives) ────────────────────────────────────────────
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ─── Access control & role ────────────────────────────────────────────────────
# One entry per person:  VEGA_API_KEY=<name>:<secret>,<name>:<secret>
#  * a secret must be 32+ characters (weak keys are ignored; with no strong key the server refuses everything)
#  * the NAME before ':' only labels who is calling in the audit log — clients send just the secret
#  * start.sh creates a strong key named "owner" if there is none; add people with:
#        python3 backend/app/auth/keygen.py add <name>
#  * edit this line any time — it takes effect without a restart (delete a person's entry to revoke them)
#  * on a CONSUMER machine put just your own secret here (no name)
VEGA_API_KEY=
# server   = this system runs the scanners / executor / API (only ONE system should)
# consumer = this system only shows the UI and talks to the server below; it never trades
VEGA_ROLE=server
VEGA_SERVER_URL=
# Production defaults — change only if you know why:
# VEGA_RATE_LIMIT_PER_MIN=1200      # requests per person per minute (0 = unlimited)
# VEGA_AUTH_MAX_FAILURES=5          # wrong keys from one address before it is locked out
# VEGA_AUTH_LOCKOUT_SEC=900         # how long that lockout lasts
# VEGA_AUDIT_RETENTION_DAYS=90      # audit files older than this are deleted at startup
# VEGA_CORS_EXTRA=                  # extra browser origins allowed to call the API (comma-separated)
# VEGA_AUTH_DISABLED=true           # LOCAL DEVELOPMENT ONLY: turns key protection off entirely
