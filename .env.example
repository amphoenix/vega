# ─────────────────────────────────────────────────────────────────────────────
# Vega .env — SECRETS & MASTER SWITCHES ONLY
# All trading params (risk, strategies, scanner config) live in config/*.yaml
# and config.py — do NOT duplicate them here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM (manual analysis / news / ai-predict only — scanners are LLM-free) ──
# 'openai' → any OpenAI-compatible API (Anthropic, OpenAI, Groq, Qwen, Ollama…)
# 'bedrock' → AWS Bedrock via litellm
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL_NAME=claude-sonnet-4-6
LLM_API_KEY_2=
LLM_API_KEY_3=

# ─── Broker Secrets (selection in config/brokers.yaml: dhan | indmoney) ──────
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
INDMONEY_ACCESS_TOKEN=

# ─── Crypto (Deribit — only if crypto F&O enabled) ───────────────────────────
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# ─── Master Switches (safe defaults: everything off) ─────────────────────────
LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
SCALP_AUTO_TRADING_ENABLED=false
TRADING_MODE=paper

# ─── Optional ────────────────────────────────────────────────────────────────
ZEP_API_KEY=
