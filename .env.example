# ─── LLM Provider ─────────────────────────────────────────────────────────────
# 'bedrock' → AWS Bedrock via litellm
# 'openai'  → any OpenAI-compatible API (Anthropic, OpenAI, Groq, Qwen, Ollama…)
LLM_PROVIDER=openai

# Option A — OpenAI-compatible (LLM_PROVIDER=openai)
# Works for: OpenAI, Anthropic, Google AI Studio (Gemma/Gemini), Groq, Qwen,
# Ollama (base_url contains :11434 → uses native /api/chat).
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL_NAME=claude-sonnet-4-6
# Optional extra keys — pooled with LLM_API_KEY for round-robin + rate
# tracking. Useful when each key is on its own per-project quota
# (e.g. Google AI Studio Gemma free tier = 15 RPM per key).
LLM_API_KEY_2=
LLM_API_KEY_3=
# Block up to this many seconds for a free (non-cooling) key before raising
# TimeoutError. Caller falls back, so 5s is fail-soft.
LLM_ACQUIRE_TIMEOUT_SEC=5
# Per-HTTP-call timeout. Gemma usually responds in 2-5s; 30s cuts off
# hanging connections fast so scanner cycles complete within 120s.
LLM_REQUEST_TIMEOUT_SEC=60

# Option B — AWS Bedrock (LLM_PROVIDER=bedrock)
# Bedrock path is single-key, single-endpoint — bypasses the rate-aware pool
# entirely. None of the LLM_API_KEY_* / LLM_RPM_* / LLM_CONCURRENCY vars apply.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20251001-v1:0

# ─── Broker (live ticks + orders) ─────────────────────────────────────────────
# Get token at https://indstocks.com → API section.
INDMONEY_ACCESS_TOKEN=
# Set to 'true' to enable real order execution. When false/unset, order
# endpoints return a simulated success response without hitting the broker.
LIVE_TRADING_ENABLED=false
# Paper trading capital (used for risk % calculations when LIVE_TRADING_ENABLED=false)
PAPER_CAPITAL_INR=100000

# ─── Auto-Execution ───────────────────────────────────────────────────────────
# Swing auto-trading: false = monitor only, true = auto-enter on signal
# SAFE DEFAULT: false — enable explicitly when you're ready to trade.
AUTO_TRADING_ENABLED=false
# Scalp auto-trading: separate toggle. If unset, falls back to AUTO_TRADING_ENABLED
# SAFE DEFAULT: false — enable explicitly when you're ready to trade.
SCALP_AUTO_TRADING_ENABLED=false
# Minimum CIO confidence (0-100) to auto-place a BUY order. Below this → skip.
AUTO_ENTRY_MIN_CONFIDENCE=95
# Maximum stop-loss in premium points per underlying (from buy price).
# SENSEX/BANKEX options: max 50pt drop before exit.
# NIFTY/BANKNIFTY options: max 15pt drop before exit.
SL_MAX_POINTS_SENSEX=50
SL_MAX_POINTS_NIFTY=15
# Allow re-entry after SL exit if signal still valid? 1=yes 0=no
ALLOW_REENTRY_AFTER_SL=1
# Max re-entries per symbol per day
MAX_REENTRIES_PER_DAY=1
# Daily loss limit — ALL auto-trading stops when cumulative realized loss hits this (₹)
DAILY_LOSS_LIMIT_INR=1000
# Base limit — restored every new day (never changed by kill-switch bumps)
DAILY_LOSS_LIMIT_BASE=1000

# ─── F&O Scanner ──────────────────────────────────────────────────────────────
# cycle period (0 = disable auto-scan)
FO_SCAN_INTERVAL_SEC=180
# max concurrent open positions
FO_MAX_POSITIONS=3
# CIO confidence threshold (0-100)
FO_MIN_CONFIDENCE=70
# min agents agreeing (of 5)
FO_MIN_AGENTS=3
# min days-to-expiry
FO_MIN_DTE=2
# max days-to-expiry
FO_MAX_DTE=35
# strike selection delta target
FO_TARGET_DELTA=0.55
# max bid-ask spread % (liquidity gate)
FO_MAX_SPREAD_PCT=3
# min open interest (0 = no gate)
FO_MIN_OI=0
# 1 = enable FUT shorts (needs SPAN margin)
ALLOW_FUT_SHORT=0

# ─── Scalp Scanner ─────────────────────────────────────────────────────────────
# Momentum-based scalp trading on 1-min candles (Donchian breakout + RSI + volume)
# All scalp defaults (SL, T1, ADX, filters, etc.) live in SCALP_CONFIG_SCHEMA
# inside scalp_scanner.py. Only add overrides here if you need non-default values.
# SAFE DEFAULT: false — start disabled; enable after reviewing defaults in code.
SCALP_ENABLED=false
# Tickers to scan (defaults to FO_UNIVERSE if unset)
SCALP_UNIVERSE=^NSEI,^BSESN
# Number of lots per scalp trade (editable live from UI Config panel)
SCALP_LOTS_PER_TRADE=1

# ─── Optional: ZEP Memory Graph (only needed for OASIS simulation) ────────────
ZEP_API_KEY=

# ─── Optional: Kernel semantic memory (Qdrant + Ollama) ───────────────────────
# docker run -p 6333:6333 qdrant/qdrant   |   ollama pull nomic-embed-text
QDRANT_URL=http://localhost:6333
EMBED_MODEL=nomic-embed-text
