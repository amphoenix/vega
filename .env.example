# ─────────────────────────────────────────────────────────────────────────────
# Vega .env — SECRETS & MASTER SWITCHES ONLY
#
# All trading parameters (risk, strategies, stop-losses, scanner config)
# live in config/*.yaml — do NOT duplicate them here.
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# 'openai'  → any OpenAI-compatible API (Anthropic, OpenAI, Groq, Qwen, Ollama…)
# 'bedrock' → AWS Bedrock via litellm
LLM_PROVIDER=openai

# OpenAI-compatible keys
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL_NAME=claude-sonnet-4-6
LLM_API_KEY_2=
LLM_API_KEY_3=

# AWS Bedrock (only if LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20251001-v1:0

# ─── Broker Secrets ───────────────────────────────────────────────────────────
# Broker selection & wiring is in config/brokers.yaml — only secrets go here.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
INDMONEY_ACCESS_TOKEN=

# ─── Master Switches ─────────────────────────────────────────────────────────
# SAFE DEFAULTS: everything off. Enable explicitly when ready.
LIVE_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false
SCALP_AUTO_TRADING_ENABLED=false
TRADING_MODE=paper

# ─── Forex Scanner (always on, technical-only, no LLM, broker-agnostic) ─────
FOREX_UNIVERSE=USDINR=X,EURINR=X,GBPINR=X,JPYINR=X
FOREX_SCAN_INTERVAL_SEC=180
FOREX_MIN_CONFIDENCE=60
FOREX_MAX_RISK_PCT=2.0

# ─── Optional Services ───────────────────────────────────────────────────────
ZEP_API_KEY=
