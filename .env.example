# ─── LLM Provider ─────────────────────────────────────────────────────────────
# 'bedrock' → AWS Bedrock via litellm
# 'openai'  → any OpenAI-compatible API (Anthropic, OpenAI, Groq, Qwen, Ollama…)
LLM_PROVIDER=openai

# Option A — OpenAI-compatible (LLM_PROVIDER=openai)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL_NAME=claude-sonnet-4-6

# Option B — AWS Bedrock (LLM_PROVIDER=bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-20251001-v1:0

# ─── Broker (live ticks + orders) ─────────────────────────────────────────────
# Get token at https://indstocks.com → API section.
INDMONEY_ACCESS_TOKEN=

# ─── F&O Scanner ──────────────────────────────────────────────────────────────
FO_SCAN_INTERVAL_SEC=180         # cycle period (0 = disable auto-scan)
FO_MAX_POSITIONS=3               # max concurrent open positions
FO_MIN_CONFIDENCE=70             # CIO confidence threshold (0-100)
FO_MIN_AGENTS=3                  # min agents agreeing (of 5)
FO_MIN_DTE=2                     # min days-to-expiry
FO_MAX_DTE=35                    # max days-to-expiry
FO_TARGET_DELTA=0.55             # strike selection delta target
FO_MAX_SPREAD_PCT=3              # max bid-ask spread % (liquidity gate)
FO_MIN_OI=0                      # min open interest (0 = no gate)
ALLOW_FUT_SHORT=0                # 1 = enable FUT shorts (needs SPAN margin)

# ─── Optional: ZEP Memory Graph (only needed for OASIS simulation) ────────────
ZEP_API_KEY=

# ─── Optional: Kernel semantic memory (Qdrant + Ollama) ───────────────────────
# docker run -p 6333:6333 qdrant/qdrant   |   ollama pull nomic-embed-text
QDRANT_URL=http://localhost:6333
EMBED_MODEL=nomic-embed-text
